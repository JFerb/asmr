    <ray>
      <scan>
        <horizontal>
          <samples><!-- TODO --></samples>
          <resolution><!-- TODO --></resolution>
          <min_angle><!-- TODO --></min_angle>
          <max_angle><!-- TODO --></max_angle>
        </horizontal>
        <vertical>
          <samples>1</samples>
          <resolution>0.01</resolution>
          <min_angle>0</min_angle>
          <max_angle>0</max_angle>
        </vertical>
      </scan>
      <range>
